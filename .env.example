# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Stripe Keys
STRIP_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Service (Nodemailer / Gmail or SendGrid)
GOOGLE_PASS=your_google_app_password
SENDGRID_API_KEY=your_sendgrid_api_key

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/TourAndTravel

# Application URLs & Port
PORT=3000
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# AI & Vector Search Configurations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
